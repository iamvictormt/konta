{
  "name": "konta",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "db:status": "docker compose ps db",
    "db:migrate": "auth migrate --config app/lib/server/auth.ts --yes && node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:create-admin": "node --env-file-if-exists=.env scripts/create-store-owner.mjs",
    "db:create-platform-admin": "node scripts/create-platform-admin.mjs",
    "db:grant-platform-admin": "node --env-file-if-exists=.env scripts/grant-platform-admin.mjs",
    "db:setup": "npm run db:up && npm run db:migrate && node --env-file-if-exists=.env scripts/seed-local-store.mjs && npm run db:create-admin -- --organization-id default"
  },
  "dependencies": {
    "better-auth": "^1.7.18",
    "next": "16.4.5",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.18",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
