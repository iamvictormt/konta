{
  "name": "konta",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "auth migrate --config app/lib/server/auth.ts --yes && node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:create-admin": "node --env-file-if-exists=.env scripts/create-store-owner.mjs",
    "db:create-platform-admin": "node scripts/create-platform-admin.mjs",
    "db:grant-platform-admin": "node --env-file-if-exists=.env scripts/grant-platform-admin.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.18",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.18",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
